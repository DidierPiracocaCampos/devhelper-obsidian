{
  "name": "devhelper-dashboard",
  "version": "0.1.0",
  "description": "Dashboard de proyectos y tareas respaldados por notas Markdown.",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dashboard",
    "projects",
    "tasks"
  ],
  "author": "DevHelper",
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "js-yaml": "4.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
