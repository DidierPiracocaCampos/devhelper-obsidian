{
  "name": "devhelper-dashboard",
  "version": "0.3.0",
  "description": "Dashboard de proyectos y tareas respaldados por notas Markdown.",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update:test-vault": "node scripts/update-test-vault.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dashboard",
    "projects",
    "tasks"
  ],
  "author": "Didier Piracoca",
  "repository": {
    "type": "git",
    "url": "https://github.com/DidierPiracocaCampos/devhelper-obsidian.git"
  },
  "license": "MIT",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "skills/**"
  ],
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "js-yaml": "4.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
